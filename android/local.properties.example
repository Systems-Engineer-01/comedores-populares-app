# Copia este archivo como local.properties y completa los valores reales.
# NO commitees local.properties al repositorio.

# API Key de Gemini (obtener en https://aistudio.google.com/apikey)
GEMINI_API_KEY=TU_API_KEY_AQUI

# URL del Web App de Google Apps Script
# (Extensiones > Apps Script > Implementar > Aplicación Web > copiar URL)
BACKEND_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_ID/exec
